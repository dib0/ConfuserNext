<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>ConfuserNext.Tests</RootNamespace>
    <AssemblyName>ConfuserNext.Tests</AssemblyName>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);CS0618</NoWarn>
    <!-- Signed with the same ConfuserNext.snk as every other project (inherited from
         Directory.Build.props). The source projects' InternalsVisibleTo attributes reference
         this assembly's public key directly, since the C# compiler requires that whenever the
         declaring assembly is itself strong-name signed. -->
    <PublicKey></PublicKey>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="coverlet.collector" Version="6.0.2" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.11.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ConfuserNext.Core\ConfuserNext.Core.csproj" />
    <ProjectReference Include="..\ConfuserNext.DynCipher\ConfuserNext.DynCipher.csproj" />
    <ProjectReference Include="..\ConfuserNext.Renamer\ConfuserNext.Renamer.csproj" />
    <ProjectReference Include="..\ConfuserNext.Protections\ConfuserNext.Protections.csproj" />
    <ProjectReference Include="..\ConfuserNext.Runtime\ConfuserNext.Runtime.csproj" />
  </ItemGroup>

</Project>
